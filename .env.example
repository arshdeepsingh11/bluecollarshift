# Blue Collar web app — copy to .env (never commit .env).
# Supabase is used for AUTHENTICATION ONLY. Publishable key is safe for browsers. NEVER put the service_role/secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Blue Collar API (server/). Local: http://localhost:8080  Production: https://api.bluecollarshift.com
VITE_API_URL=http://localhost:8080
# Optional. Restrict the key to your domains + Maps JavaScript API + Geocoding API, with quotas and a budget alert.
VITE_GOOGLE_MAPS_API_KEY=
