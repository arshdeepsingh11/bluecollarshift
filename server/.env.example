# Blue Collar API — copy to .env for local development. NEVER commit .env.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres login role bc_api (password set with: alter role bc_api with password '...').
# Production: Supabase pooler, transaction mode (port 6543), SSL required.
DATABASE_URL=postgres://bc_api.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=require
# Supabase signs its DB certificate with its own CA. Download it (Database Settings > SSL Configuration)
# and point to it, so the connection is verified (never disable verification).
DATABASE_CA_CERT_FILE=certs/supabase-ca.crt
DATABASE_POOL_MAX=10

SUPABASE_URL=https://<project-ref>.supabase.co
# Only if the project still uses the legacy shared JWT secret (Settings > API > JWT). Leave empty with asymmetric keys.
SUPABASE_JWT_SECRET=
# Release A: file uploads (voice feedback, safety photos). Supabase > Settings > API Keys > secret key.
# API server ONLY. Never put this in VITE_* or EXPO_PUBLIC_*. Empty = uploads off, typed feedback still works.
SUPABASE_SERVICE_ROLE_KEY=

# Links in emails. Production: https://app.bluecollarshift.com  Local: http://localhost:5173/app
APP_URL=https://app.bluecollarshift.com
ADMIN_URL=https://admin.bluecollarshift.com
# Local: http://localhost:5173,http://localhost:4173   Production:
CORS_ORIGINS=https://bluecollarshift.com,https://app.bluecollarshift.com,https://admin.bluecollarshift.com

# Email (Resend). Without a key, emails are written to EMAIL_OUTBOX_DIR for local testing.
RESEND_API_KEY=
EMAIL_FROM=Blue Collar <no-reply@bluecollarshift.com>
EMAIL_OUTBOX_DIR=.mail-outbox

# Optional: Expo access token (only if "enhanced push security" is enabled in Expo)
EXPO_ACCESS_TOKEN=
JOBS_ENABLED=true
LATE_GRACE_MINUTES=10
# Optional: Slack/Discord-compatible webhook for critical admin alerts
ALERT_WEBHOOK_URL=
