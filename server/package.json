{
  "name": "@bluecollar/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Blue Collar API \u2014 Node.js + TypeScript modular monolith (REST + Socket.IO + background jobs).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "loadtest": "node tests/load/run.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "jose": "^6.2.18",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "autocannon": "^9.0.0",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vitest": "^5.1.2"
  }
}
