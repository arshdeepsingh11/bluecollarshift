# Blue Collar mobile — local development. For EAS builds set these as EAS environment variables.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Android map tiles (restricted to the Android app's package + SHA-1). iOS uses Apple Maps by default.
GOOGLE_MAPS_ANDROID_API_KEY=
EAS_PROJECT_ID=
